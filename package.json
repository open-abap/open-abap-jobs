    "test": "npm run lint && npm run unit"
  },
  "license": "",
  "dependencies": {
    "@abaplint/cli": "^2.120.77",
    "@abaplint/database-pg": "^2.11.83",
    "@abaplint/runtime": "^2.14.4",
    "@abaplint/transpiler-cli": "^2.14.4"
  },
  "devDependencies": {
    "rimraf": "^6.1.3"
  }
}
