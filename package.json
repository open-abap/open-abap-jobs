{
  "name": "open-abap-jobs",
  "version": "1.0.0",
  "private": true,
  "description": "test",
  "scripts": {
    "lint": "abaplint",
    "unit": "rimraf output && abap_transpile abap_transpile.jsonc && echo RUNNING && node output/index.mjs",
    "docker:start": "docker compose -p open-abap-jobs -f test/stack.yml up -d",
